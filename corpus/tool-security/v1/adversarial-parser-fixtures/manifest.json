      "reason": "an unknown top-level field must not be ignored"
    },
    {
      "id": "unknown-nested-field",
      "kind": "CORPUS_ENTRY",
      "path": "unknown-nested-field.json",
      "reason": "an unknown field nested inside provenance must not be ignored"
