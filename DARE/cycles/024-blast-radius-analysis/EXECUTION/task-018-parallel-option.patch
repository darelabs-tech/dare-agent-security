+/// One search of one seed, reduced to its summary for that seed's
+/// candidate targets.
+fn view_summary<'g>(
+    index: &Indexed<'g>,
+    seed: &ResolvedSeed,
+    view: View,
+    bounds: Bounds,
+    budget: &mut u64,
+) -> Summary<'g> {
+    let found = search(
+        index,
+        &seed.node,
+        initial_authority(seed.kind, &seed.node),
+        view,
+        bounds,
+        budget,
+        None,
+    );
+    let wanted = candidates(index, seed);
+    found.summarise(wanted.iter().map(|(node, _)| node.as_str()))
+}
