+const VIEWS: [View; 2] = [View::Structural, View::Uncontained];
+
+/// The reports of every seed, in seed order, exactly as if every search ran
+/// in turn against the shared budget: each seed's structural view, then its
+/// uncontained view (REGRESSION R-6).
+fn seed_reports(
+    index: &Indexed<'_>,
+    seeds: &[ResolvedSeed],
+    bounds: Bounds,
+    budget: &mut u64,
+) -> Vec<SeedReport> {
+    let workers = std::thread::available_parallelism().map_or(1, |n| n.get());
+    seed_reports_with(index, seeds, bounds, budget, workers)
+}
+
+/// `seed_reports` with an explicit worker count; exposed so a test can
+/// compare every count against the sequential run.
+///
+/// Worker threads run searches ahead of their turn, each against the budget
+/// left when it starts, which is never less than what will be left when its
+/// turn comes. The calling thread takes the searches in turn and keeps one
+/// only when it fits the budget actually left: a search that never needed
+/// more states than remained never reached the budget check, so it is the
+/// same search. Otherwise it runs that search again here, against the real
+/// budget. No outcome depends on thread timing. Each worker frees its own
+/// search arena; only the summary crosses threads.
+#[doc(hidden)]
+pub fn seed_reports_with<'g>(
+    index: &Indexed<'g>,
+    seeds: &[ResolvedSeed],
+    bounds: Bounds,
+    budget: &mut u64,
+    workers: usize,
+) -> Vec<SeedReport> {
+    let units = seeds.len() * VIEWS.len();
+    let workers = workers.min(units).min(MAX_WORKERS);
+    let unit = |i: usize| (&seeds[i / VIEWS.len()], VIEWS[i % VIEWS.len()]);
+    let mut summaries: Vec<Summary<'g>> = Vec::with_capacity(units);
+    if workers <= 1 {
+        for i in 0..units {
+            let (seed, view) = unit(i);
+            summaries.push(view_summary(index, seed, view, bounds, budget));
+        }
+    } else {
+        let next = AtomicUsize::new(0);
+        let left = AtomicU64::new(*budget);
+        std::thread::scope(|scope| {
+            let (done, results) = mpsc::channel();
+            for _ in 0..workers {
+                let done = done.clone();
+                let (next, left) = (&next, &left);
+                scope.spawn(move || loop {
+                    if left.load(Ordering::Acquire) == 0 {
+                        // Every later search runs against an empty budget,
+                        // which the calling thread does in no time.
+                        break;
+                    }
+                    let i = next.fetch_add(1, Ordering::AcqRel);
+                    if i >= units {
+                        break;
+                    }
+                    let (seed, view) = unit(i);
+                    let mut ahead = left.load(Ordering::Acquire);
+                    let summary = view_summary(index, seed, view, bounds, &mut ahead);
+                    if done.send((i, summary)).is_err() {
+                        break;
+                    }
+                });
+            }
+            drop(done);
+            let mut ahead: BTreeMap<usize, Summary<'g>> = BTreeMap::new();
+            let mut settle = |summaries: &mut Vec<Summary<'g>>, run: Option<Summary<'g>>| {
+                let (seed, view) = unit(summaries.len());
+                let kept = run.filter(|s| fits(&s.report, *budget));
+                let summary = match kept {
+                    Some(summary) => {
+                        *budget -= summary.report.states_explored;
+                        summary
+                    }
+                    None => {
+                        // A search that does not fit empties the budget.
+                        left.store(0, Ordering::Release);
+                        view_summary(index, seed, view, bounds, budget)
+                    }
+                };
+                left.store(*budget, Ordering::Release);
+                summaries.push(summary);
+            };
+            for (i, summary) in results {
+                ahead.insert(i, summary);
+                while let Some(run) = ahead.remove(&summaries.len()) {
+                    settle(&mut summaries, Some(run));
+                }
+            }
+            // Searches no worker took.
+            while summaries.len() < units {
+                let run = ahead.remove(&summaries.len());
+                settle(&mut summaries, run);
+            }
+        });
+    }
+    summaries
+        .chunks(VIEWS.len())
+        .zip(seeds)
+        .map(|(views, seed)| seed_report(index, seed, &views[0], &views[1]))
+        .collect()
+}
+
+/// A search run ahead of its turn is the search its turn would run when it
+/// needed no more states than `budget`. One stopped by its own smaller
+/// budget is kept only when that budget was exactly `budget`.
+fn fits(report: &SearchReport, budget: u64) -> bool {
+    let used = report.states_explored;
+    if report.stopped_by == Some(StopBound::MaxStatesTotal) {
+        used == budget
+    } else {
+        used <= budget
+    }
+}
