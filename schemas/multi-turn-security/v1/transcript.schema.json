{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://darelabs.tech/schemas/multi-turn-security/v1/transcript.schema.json",
  "title": "DARE Multi-Turn Replay Transcript v1",
  "description": "A sanitized, local, previously recorded multi-turn transcript. Replay evaluates what the transcript says the target did on each turn. It sends nothing and declares no verdict. Each recorded turn names the strategy-graph node it answered; a transcript that reorders, inserts or drops turns is a strategy fault, and one whose chain digest does not match is refused.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "graph_digests",
    "conversations"
  ],
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "graph_digests": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/digest"
      }
    },
    "conversations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "conversation_id",
          "turns"
        ],
        "properties": {
          "conversation_id": {
            "$ref": "#/$defs/id"
          },
          "turns": {
            "type": "array",
            "maxItems": 32,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "index",
                "node_id",
                "output"
              ],
              "properties": {
                "index": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 31
                },
                "node_id": {
                  "$ref": "#/$defs/id"
                },
                "output": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "refusal",
                    "fulfillment",
                    "actions"
                  ],
                  "properties": {
                    "output_text": {
                      "type": "string",
                      "maxLength": 16384
                    },
                    "refusal": {
                      "type": "boolean"
                    },
                    "decision": {
                      "enum": [
                        "ALLOW",
                        "DENY"
                      ]
                    },
                    "fulfillment": {
                      "enum": [
                        "FULL",
                        "PARTIAL",
                        "NO_FULFILLMENT"
                      ]
                    },
                    "accepted_authority": {
                      "enum": [
                        "NONE",
                        "READ",
                        "WRITE",
                        "ADMIN"
                      ]
                    },
                    "actions": {
                      "type": "array",
                      "maxItems": 8,
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "action_id",
                          "action_class",
                          "executed",
                          "action_digest",
                          "required_authority",
                          "argument_text"
                        ],
                        "properties": {
                          "action_id": {
                            "$ref": "#/$defs/id"
                          },
                          "action_class": {
                            "$ref": "#/$defs/id"
                          },
                          "executed": {
                            "type": "boolean"
                          },
                          "approval_ref": {
                            "$ref": "#/$defs/id"
                          },
                          "action_digest": {
                            "$ref": "#/$defs/digest"
                          },
                          "required_authority": {
                            "enum": [
                              "NONE",
                              "READ",
                              "WRITE",
                              "ADMIN"
                            ]
                          },
                          "argument_text": {
                            "type": "string",
                            "maxLength": 1024
                          }
                        }
                      }
                    },
                    "harness_error": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "kind"
                      ],
                      "properties": {
                        "kind": {
                          "enum": [
                            "ADAPTER_FAILURE",
                            "CONTROL_TRIGGERED",
                            "STRATEGY_FAULT",
                            "OUTPUT_TOO_LARGE"
                          ]
                        }
                      }
                    }
                  }
                },
                "chain_digest": {
                  "$ref": "#/$defs/digest"
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
