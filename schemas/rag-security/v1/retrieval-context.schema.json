{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://darelabs.tech/schemas/rag-security/v1/retrieval-context.schema.json",
  "title": "DARE RAG Security Retrieval Context v1",
  "description": "Who is retrieving, under which tenant, scoped to which collections.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "context_id",
    "principals",
    "acting_principal_id",
    "tenant_id",
    "collection_ids"
  ],
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "context_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9]+([-_.][A-Za-z0-9]+)*$",
      "minLength": 1,
      "maxLength": 200
    },
    "principals": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "principal_id",
          "kind",
          "tenant_id"
        ],
        "properties": {
          "principal_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9]+([-_.][A-Za-z0-9]+)*$",
            "minLength": 1,
            "maxLength": 200
          },
          "kind": {
            "description": "Reused verbatim from Cycle 015. Retrieval never reinterprets an identity.",
            "type": "string",
            "enum": [
              "HUMAN",
              "AGENT",
              "WORKLOAD",
              "SERVICE"
            ]
          },
          "tenant_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9]+([-_.][A-Za-z0-9]+)*$",
            "minLength": 1,
            "maxLength": 200
          },
          "display_label": {
            "type": "string",
            "maxLength": 200
          }
        }
      }
    },
    "acting_principal_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9]+([-_.][A-Za-z0-9]+)*$",
      "minLength": 1,
      "maxLength": 200
    },
    "tenant_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9]+([-_.][A-Za-z0-9]+)*$",
      "minLength": 1,
      "maxLength": 200
    },
    "collection_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9]+([-_.][A-Za-z0-9]+)*$",
        "minLength": 1,
        "maxLength": 200
      }
    }
  }
}
