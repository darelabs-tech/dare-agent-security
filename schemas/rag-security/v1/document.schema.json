{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://darelabs.tech/schemas/rag-security/v1/document.schema.json",
  "title": "DARE RAG Security Document v1",
  "description": "One indexed synthetic document. Identity, tenant, owner, collection, classification and trust are declared; the body never is. A verdict is reached by comparing declared identifiers, never by reading content.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "document_id",
    "collection_id",
    "tenant_id",
    "owner_principal_id",
    "provenance",
    "trust_class",
    "classification",
    "content_digest",
    "metadata_digest"
  ],
  "properties": {
    "document_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9]+([-_.][A-Za-z0-9]+)*$",
      "minLength": 1,
      "maxLength": 200
    },
    "collection_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9]+([-_.][A-Za-z0-9]+)*$",
      "minLength": 1,
      "maxLength": 200
    },
    "tenant_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9]+([-_.][A-Za-z0-9]+)*$",
      "minLength": 1,
      "maxLength": 200
    },
    "owner_principal_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9]+([-_.][A-Za-z0-9]+)*$",
      "minLength": 1,
      "maxLength": 200
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provenance_id",
        "source_kind"
      ],
      "properties": {
        "provenance_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9]+([-_.][A-Za-z0-9]+)*$",
          "minLength": 1,
          "maxLength": 200
        },
        "source_kind": {
          "type": "string",
          "enum": [
            "INTERNAL_AUTHORED",
            "TENANT_UPLOAD",
            "EXTERNAL_INGESTED",
            "AGENT_GENERATED",
            "IMPORTED_CORPUS",
            "TOOL_OUTPUT"
          ]
        },
        "source_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9]+([-_.][A-Za-z0-9]+)*$",
          "minLength": 1,
          "maxLength": 200,
          "description": "Optional. A document whose origin was never recorded has no source_id, which is exactly what the provenance invariant detects."
        },
        "author_principal_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9]+([-_.][A-Za-z0-9]+)*$",
          "minLength": 1,
          "maxLength": 200
        },
        "source_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "trust_class": {
      "type": "string",
      "enum": [
        "UNTRUSTED",
        "REFERENCE",
        "TRUSTED_POLICY"
      ]
    },
    "classification": {
      "type": "string",
      "enum": [
        "PUBLIC",
        "INTERNAL",
        "CONFIDENTIAL",
        "RESTRICTED"
      ]
    },
    "state": {
      "type": "string",
      "enum": [
        "ACTIVE",
        "SUPERSEDED",
        "WITHDRAWN"
      ]
    },
    "content_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "metadata_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "metadata": {
      "description": "Opaque labels a filter may constrain. Bounded so a document cannot carry an unbounded map.",
      "type": "object",
      "maxProperties": 32,
      "additionalProperties": {
        "type": "string",
        "maxLength": 200
      }
    },
    "content_excerpt": {
      "description": "A short human-legible excerpt. No evaluator reads it.",
      "type": "string",
      "maxLength": 4096
    },
    "labels": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9]+([-_.][A-Za-z0-9]+)*$",
        "minLength": 1,
        "maxLength": 200
      }
    }
  }
}
