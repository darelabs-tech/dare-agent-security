{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://darelabs.tech/schemas/rag-security/v1/trace.schema.json",
  "title": "DARE RAG Security Replay Trace v1",
  "description": "A sanitized local recording of a retrieval run. A trace names objects by id; the scenario's declared corpus supplies the bindings, so a trace cannot assert that a chunk belonged to a document it did not.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "trace_id",
    "scenario_id",
    "mode",
    "synthetic",
    "trials"
  ],
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "trace_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9]+([-_.][A-Za-z0-9]+)*$",
      "minLength": 1,
      "maxLength": 200
    },
    "scenario_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9]+([-_.][A-Za-z0-9]+)*$",
      "maxLength": 96
    },
    "mode": {
      "description": "Fixed. A trace can only ever be replayed.",
      "const": "REPLAY"
    },
    "synthetic": {
      "description": "Fixed. Every Cycle 017 trace is synthetic; one claiming to be production evidence is refused.",
      "const": true
    },
    "description": {
      "type": "string",
      "maxLength": 300
    },
    "trials": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "queries": {
            "type": "array",
            "maxItems": 8,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "query_id",
                "collection_ids",
                "requested_top_k"
              ],
              "properties": {
                "query_id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9]+([-_.][A-Za-z0-9]+)*$",
                  "minLength": 1,
                  "maxLength": 200
                },
                "query_label": {
                  "description": "A label for a human reading the fixture. Never parsed, never matched against document text.",
                  "type": "string",
                  "maxLength": 300
                },
                "collection_ids": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 16,
                  "items": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9]+([-_.][A-Za-z0-9]+)*$",
                    "minLength": 1,
                    "maxLength": 200
                  }
                },
                "requested_top_k": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 16
                },
                "filter": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "mandatory": {
                      "type": "array",
                      "maxItems": 16,
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "field",
                          "operator",
                          "values"
                        ],
                        "properties": {
                          "field": {
                            "type": "string",
                            "pattern": "^[A-Za-z0-9]+([-_.][A-Za-z0-9]+)*$",
                            "minLength": 1,
                            "maxLength": 200
                          },
                          "operator": {
                            "type": "string",
                            "enum": [
                              "EQUALS",
                              "NOT_EQUALS",
                              "IN",
                              "NOT_IN"
                            ]
                          },
                          "values": {
                            "type": "array",
                            "minItems": 1,
                            "maxItems": 32,
                            "items": {
                              "type": "string",
                              "pattern": "^[A-Za-z0-9]+([-_.][A-Za-z0-9]+)*$",
                              "minLength": 1,
                              "maxLength": 200
                            }
                          }
                        }
                      }
                    }
                  }
                },
                "objective_id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9]+([-_.][A-Za-z0-9]+)*$",
                  "minLength": 1,
                  "maxLength": 200
                }
              }
            }
          },
          "candidate_sets": {
            "type": "array",
            "maxItems": 8,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "query_id",
                "candidates"
              ],
              "properties": {
                "query_id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9]+([-_.][A-Za-z0-9]+)*$",
                  "minLength": 1,
                  "maxLength": 200
                },
                "candidates": {
                  "type": "array",
                  "maxItems": 64,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "chunk_id",
                      "document_id"
                    ],
                    "properties": {
                      "chunk_id": {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9]+([-_.][A-Za-z0-9]+)*$",
                        "minLength": 1,
                        "maxLength": 200
                      },
                      "document_id": {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9]+([-_.][A-Za-z0-9]+)*$",
                        "minLength": 1,
                        "maxLength": 200
                      },
                      "score": {
                        "type": "number"
                      }
                    }
                  }
                }
              }
            }
          },
          "filter_decisions": {
            "type": "array",
            "maxItems": 64,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "query_id",
                "document_id",
                "admitted"
              ],
              "properties": {
                "query_id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9]+([-_.][A-Za-z0-9]+)*$",
                  "minLength": 1,
                  "maxLength": 200
                },
                "document_id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9]+([-_.][A-Za-z0-9]+)*$",
                  "minLength": 1,
                  "maxLength": 200
                },
                "admitted": {
                  "type": "boolean"
                }
              }
            }
          },
          "result_sets": {
            "type": "array",
            "maxItems": 8,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "query_id",
                "results"
              ],
              "properties": {
                "query_id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9]+([-_.][A-Za-z0-9]+)*$",
                  "minLength": 1,
                  "maxLength": 200
                },
                "results": {
                  "type": "array",
                  "maxItems": 16,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "chunk_id",
                      "document_id",
                      "rank"
                    ],
                    "properties": {
                      "chunk_id": {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9]+([-_.][A-Za-z0-9]+)*$",
                        "minLength": 1,
                        "maxLength": 200
                      },
                      "document_id": {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9]+([-_.][A-Za-z0-9]+)*$",
                        "minLength": 1,
                        "maxLength": 200
                      },
                      "rank": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 15
                      },
                      "score": {
                        "description": "Evidence about ordering, supplied by the fixture. Never authorization.",
                        "type": "number"
                      },
                      "from_fallback": {
                        "type": "boolean"
                      }
                    }
                  }
                },
                "used_fallback": {
                  "type": "boolean"
                }
              }
            }
          },
          "influences": {
            "description": "Whether retrieved content changed a decision. `changed: false` is a positive fact and the only basis on which a no-promotion PASS may rest.",
            "type": "array",
            "maxItems": 32,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "document_id",
                "target",
                "changed"
              ],
              "properties": {
                "document_id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9]+([-_.][A-Za-z0-9]+)*$",
                  "minLength": 1,
                  "maxLength": 200
                },
                "chunk_id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9]+([-_.][A-Za-z0-9]+)*$",
                  "minLength": 1,
                  "maxLength": 200
                },
                "target": {
                  "type": "string",
                  "enum": [
                    "OBJECTIVE",
                    "TOOL_SELECTION",
                    "TOOL_ARGUMENT",
                    "PROTECTED_FIELD",
                    "DECISION_CONTEXT"
                  ]
                },
                "field": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9]+([-_.][A-Za-z0-9]+)*$",
                  "minLength": 1,
                  "maxLength": 200
                },
                "baseline_value": {
                  "type": "string",
                  "maxLength": 200
                },
                "observed_value": {
                  "type": "string",
                  "maxLength": 200
                },
                "changed": {
                  "type": "boolean"
                },
                "treated_as_trust_class": {
                  "type": "string",
                  "enum": [
                    "UNTRUSTED",
                    "REFERENCE",
                    "TRUSTED_POLICY"
                  ]
                }
              }
            }
          },
          "harness_error": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "detail"
            ],
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "ADAPTER_FAILURE",
                  "TIMEOUT",
                  "MALFORMED_OBSERVATION",
                  "KILL_SWITCH_TRIGGERED"
                ]
              },
              "detail": {
                "type": "string",
                "maxLength": 300
              }
            }
          }
        }
      }
    }
  }
}
