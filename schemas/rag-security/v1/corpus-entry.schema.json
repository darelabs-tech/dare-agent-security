{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://darelabs.tech/schemas/rag-security/v1/corpus-entry.schema.json",
  "title": "DARE RAG Security Corpus Entry v1",
  "description": "One inert, synthetic retrieval vector or control. An entry declares how a reference retriever behaves and which invariant is evaluated; it never declares a verdict, carries no credential material, names no store or provider and contains nothing executable.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "class",
    "surface",
    "property",
    "family",
    "source_kind",
    "trust",
    "preconditions",
    "reference_behavior",
    "expected_invariant",
    "safety_class",
    "standards",
    "provenance"
  ],
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+([-_.][a-z0-9]+)*$",
      "minLength": 2,
      "maxLength": 96
    },
    "title": {
      "type": "string",
      "maxLength": 200
    },
    "class": {
      "type": "string",
      "enum": [
        "RETRIEVAL_ATTACK",
        "BENIGN_CONTROL"
      ]
    },
    "surface": {
      "type": "string",
      "enum": [
        "RETRIEVAL_AUTHORIZATION",
        "DOCUMENT_ISOLATION",
        "PROVENANCE",
        "RESULT_INTEGRITY",
        "CONTENT_TRUST",
        "PROTECTED_NONDISCLOSURE"
      ]
    },
    "property": {
      "type": "string",
      "enum": [
        "AGENT.RAG.RETRIEVAL_AUTHORIZATION_BOUNDARY",
        "AGENT.RAG.TENANT_DOCUMENT_ISOLATION",
        "AGENT.RAG.PROVENANCE_INTEGRITY",
        "AGENT.RAG.CONTENT_TRUST_BOUNDARY",
        "AGENT.RAG.RESULT_SET_INTEGRITY",
        "AGENT.RAG.PROTECTED_DOCUMENT_NONDISCLOSURE"
      ]
    },
    "family": {
      "type": "string",
      "enum": [
        "CROSS_PRINCIPAL_RETRIEVAL",
        "CROSS_TENANT_RETRIEVAL",
        "CROSS_COLLECTION_RETRIEVAL",
        "UNAUTHORIZED_DOCUMENT_RETRIEVAL",
        "METADATA_FILTER_BYPASS",
        "PROVENANCE_MISMATCH",
        "CHUNK_DOCUMENT_SUBSTITUTION",
        "NON_CANDIDATE_RESULT_INJECTION",
        "TOP_K_OVERFLOW",
        "UNTRUSTED_CONTENT_PROMOTION",
        "PROTECTED_DOCUMENT_DISCLOSURE",
        "FALLBACK_AUTHORITY_WIDENING"
      ]
    },
    "source_kind": {
      "type": "string",
      "enum": [
        "SYNTHETIC_CORPUS",
        "REPLAY_TRACE",
        "DECLARED_RETRIEVAL_POLICY"
      ]
    },
    "trust": {
      "type": "string",
      "enum": [
        "TRUSTED",
        "UNTRUSTED",
        "MIXED"
      ]
    },
    "preconditions": {
      "description": "Applicability facts the target must exhibit. Never a verdict, and never an assertion about the target's security.",
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(_[a-z0-9]+)*$",
        "maxLength": 64
      }
    },
    "surface_note": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "reference_behavior": {
      "type": "string",
      "enum": [
        "COMPLIANT",
        "CROSS_PRINCIPAL_RESULT",
        "CROSS_TENANT_RESULT",
        "CROSS_COLLECTION_RESULT",
        "UNAUTHORIZED_DOCUMENT_RESULT",
        "METADATA_FILTER_BYPASSED",
        "PROTECTED_DOCUMENT_RETURNED",
        "PROVENANCE_DETACHED",
        "CHUNK_REBOUND_TO_ANOTHER_DOCUMENT",
        "NON_CANDIDATE_RESULT_INJECTED",
        "TOP_K_EXCEEDED",
        "UNTRUSTED_CONTENT_PROMOTED",
        "RETRIEVED_WITHOUT_PROMOTION",
        "FALLBACK_WITHIN_AUTHORITY",
        "FALLBACK_WIDENED_AUTHORITY",
        "MULTIPLE_INDEPENDENT_VIOLATIONS",
        "NO_RELEVANT_OBSERVATION",
        "HARNESS_FAILURE"
      ]
    },
    "expected_invariant": {
      "description": "Which invariant this entry is evaluated against. Not an expected outcome for that invariant.",
      "type": "string",
      "enum": [
        "RETRIEVAL_PRINCIPAL_BOUNDARY_PRESERVED",
        "RETRIEVAL_TENANT_BOUNDARY_PRESERVED",
        "RETRIEVAL_COLLECTION_BOUNDARY_PRESERVED",
        "DOCUMENT_ACL_ENFORCED",
        "METADATA_FILTER_ENFORCED",
        "PROTECTED_DOCUMENT_NOT_RETRIEVED",
        "RETRIEVAL_PROVENANCE_PRESERVED",
        "CHUNK_DOCUMENT_BINDING_PRESERVED",
        "RESULT_SET_WITHIN_APPROVED_CANDIDATES",
        "TOP_K_BOUND_PRESERVED",
        "UNTRUSTED_RETRIEVED_CONTENT_NOT_PROMOTED_TO_AUTHORITY",
        "RETRIEVAL_FALLBACK_DOES_NOT_WIDEN_AUTHORITY"
      ]
    },
    "safety_class": {
      "description": "Fixed. Every Cycle 017 vector is a synthetic no-op: nothing is fetched, nothing changes state, nothing leaves the process.",
      "const": "SYNTHETIC_NOOP"
    },
    "standards": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source",
          "reference",
          "status"
        ],
        "properties": {
          "source": {
            "type": "string",
            "pattern": "^[A-Z0-9]+(_[A-Z0-9]+)*$",
            "maxLength": 64
          },
          "reference": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "status": {
            "description": "The upstream document's own status. A draft stays a draft; it never becomes a conformance claim.",
            "type": "string",
            "enum": [
              "NORMATIVE",
              "FINAL_SPECIFICATION",
              "DRAFT",
              "OPEN_PROPOSAL",
              "INFORMATIVE"
            ]
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "origin",
        "created_at",
        "license"
      ],
      "properties": {
        "origin": {
          "const": "DARE_SYNTHETIC"
        },
        "author": {
          "type": "string",
          "maxLength": 96
        },
        "created_at": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "license": {
          "type": "string",
          "maxLength": 64
        },
        "note": {
          "type": "string",
          "maxLength": 300
        }
      }
    }
  }
}
