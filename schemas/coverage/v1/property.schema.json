{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://darelabs.tech/schemas/coverage/v1/property.schema.json",
  "title": "DARE Security Property Registry entry v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "category",
    "description",
    "applicability",
    "supported_modes",
    "evidence",
    "standards"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^MCP\\.[A-Z][A-Z0-9_.]+$"
    },
    "title": { "type": "string", "minLength": 1 },
    "category": {
      "type": "string",
      "enum": [
        "DISCOVERY",
        "IDENTITY",
        "AUTHENTICATION",
        "AUTHORIZATION",
        "AUTHZ_EXECUTION_INTEGRITY",
        "CAPABILITY_EXPOSURE",
        "CREDENTIAL_BOUNDARIES",
        "EVIDENCE"
      ]
    },
    "description": { "type": "string", "minLength": 1 },
    "applicability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["predicates"],
      "properties": {
        "predicates": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": [
              "tools_present",
              "resources_present",
              "prompts_present",
              "transport_http",
              "transport_stdio",
              "authorization_present",
              "dynamic_authorization_allowed",
              "execution_integrity_supported",
              "confused_deputy_supported"
            ]
          }
        }
      }
    },
    "supported_modes": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "enum": ["static", "dynamic", "passive"] }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required_for_confirmed_verdict"],
      "properties": {
        "required_for_confirmed_verdict": { "type": "boolean" }
      }
    },
    "standards": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source", "reference", "status"],
        "properties": {
          "source": { "type": "string", "minLength": 1 },
          "reference": { "type": "string", "minLength": 1 },
          "status": {
            "type": "string",
            "enum": ["NORMATIVE", "DRAFT", "INFORMATIVE"]
          }
        }
      }
    }
  }
}
