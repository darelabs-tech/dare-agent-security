{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://darelabs.tech/schemas/coverage/v1/profile.schema.json",
  "title": "DARE Assessment Profile v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "version", "properties"],
  "properties": {
    "schema": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": {
          "type": "string",
          "const": "https://darelabs.tech/schemas/coverage/v1/profile.schema.json"
        },
        "version": { "type": "string", "pattern": "^1\\.\\d+\\.\\d+$" }
      }
    },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]+$" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "title": { "type": "string" },
    "properties": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "requirement"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "requirement": {
            "type": "string",
            "enum": ["REQUIRED", "CONDITIONAL", "OPTIONAL"]
          }
        }
      }
    }
  }
}
