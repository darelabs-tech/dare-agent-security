      "supported_modes": ["static"],
      "evidence": { "required_for_confirmed_verdict": true },
      "standards": [
        { "source": "COAZ-MCP", "reference": "argument binding", "status": "NORMATIVE" }
      ]
    },
    {
      "id": "MCP.AUTHZ.EXECUTION_INTEGRITY.CONTEXT",
      "title": "Authorization-to-execution integrity (trusted context)",
