      "evidence": { "required_for_confirmed_verdict": true },
      "standards": [
        { "source": "COAZ-MCP", "reference": "trusted context", "status": "NORMATIVE" }
      ]
    },
    {
      "id": "MCP.EVIDENCE.REDACTION",
      "title": "Evidence redaction",
