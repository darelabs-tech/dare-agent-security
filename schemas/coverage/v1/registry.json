  "properties": [
    {
      "id": "MCP.DISCOVERY.PASSIVE_BOUNDARY",
      "title": "Passive discovery boundary",
      "category": "DISCOVERY",
      "description": "Passive discovery never dispatches active or state-changing operations.",
      "applicability": { "predicates": ["tools_present"] },
      "supported_modes": ["passive", "static"],
      "evidence": { "required_for_confirmed_verdict": true },
      "standards": [
        { "source": "MCP", "reference": "tools/list vs tools/call", "status": "NORMATIVE" }
      ]
    },
    {
      "id": "MCP.DISCOVERY.EXPLICIT_TARGET",
      "title": "Explicit target discovery",
      "category": "DISCOVERY",
      "description": "Discovery requires an explicit operator-named target.",
      "applicability": { "predicates": ["tools_present"] },
      "supported_modes": ["passive", "static"],
      "evidence": { "required_for_confirmed_verdict": true },
      "standards": [
        { "source": "DARE", "reference": "Cycle 002 explicit target", "status": "INFORMATIVE" }
      ]
    },
    {
      "id": "MCP.AUTHZ.PER_OPERATION",
      "title": "Per-operation authorization presence",
