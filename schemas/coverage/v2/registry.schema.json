{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://darelabs.tech/schemas/coverage/v2/registry.schema.json",
  "title": "DARE Security Property Registry v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "properties"],
  "properties": {
    "schema": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": {"const": "https://darelabs.tech/schemas/coverage/v2/registry.json"},
        "version": {"type": "string", "pattern": "^2\\.\\d+\\.\\d+$"}
      }
    },
    "properties": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "object"}
    }
  }
}
