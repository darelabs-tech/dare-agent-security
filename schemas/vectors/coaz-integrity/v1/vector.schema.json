{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://darelabs.tech/schemas/vectors/coaz-integrity/v1/vector.schema.json",
  "title": "COAZ-MCP Authorization Integrity Vector Definition v1",
  "description": "Portable, versioned authorization-integrity test intent. Structural validation only; semantic invariants are enforced by dare-coaz-integrity.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "vector_id",
    "title",
    "standards",
    "initial_operation",
    "trusted_context",
    "projector_fixture",
    "pdp_fixture",
    "mutation",
    "expected",
    "safety"
  ],
  "properties": {
    "schema_version": { "$ref": "#/$defs/schemaVersion" },
    "vector_id": { "$ref": "#/$defs/vectorId" },
    "title": { "type": "string", "minLength": 1 },
    "standards": { "$ref": "#/$defs/standardsSnapshot" },
    "initial_operation": { "$ref": "#/$defs/mcpOperation" },
    "trusted_context": { "$ref": "#/$defs/trustedAuthorizationContext" },
    "projector_fixture": { "$ref": "#/$defs/projectorFixture" },
    "pdp_fixture": { "$ref": "#/$defs/pdpFixture" },
    "mutation": { "$ref": "#/$defs/integrityMutation" },
    "expected": { "$ref": "#/$defs/vectorExpectation" },
    "safety": { "$ref": "#/$defs/safetyConstraints" }
  },
  "$defs": {
    "schemaVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "vectorId": {
      "type": "string",
      "minLength": 1,
      "pattern": "^COAZ-INTEGRITY-[0-9]{3}$"
    },
    "standardsSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "references", "executable_scope"],
      "properties": {
        "schema_version": { "$ref": "#/$defs/schemaVersion" },
        "references": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/standardReference" }
        },
        "executable_scope": { "$ref": "#/$defs/executableScopeNote" }
      }
    },
    "standardReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family", "document", "version", "status"],
      "properties": {
        "family": { "type": "string", "minLength": 1 },
        "document": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "status": {
          "type": "string",
          "enum": ["NORMATIVE", "DRAFT", "OPEN_PROPOSAL"]
        },
        "section": { "type": "string", "minLength": 1 },
        "upstream_issue": { "type": "string", "minLength": 1 }
      }
    },
    "executableScopeNote": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mcp_method_scope", "lifecycle_skew_note"],
      "properties": {
        "mcp_method_scope": { "type": "string", "minLength": 1 },
        "lifecycle_skew_note": { "type": "string", "minLength": 1 }
      }
    },
    "mcpOperation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "params"],
      "properties": {
        "method": { "type": "string", "minLength": 1 },
        "params": { "$ref": "#/$defs/canonicalValue" }
      }
    },
    "trustedAuthorizationContext": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subject_id", "claims"],
      "properties": {
        "subject_id": { "type": "string", "minLength": 1 },
        "agent_id": { "type": "string", "minLength": 1 },
        "claims": { "$ref": "#/$defs/canonicalValue" }
      }
    },
    "canonicalValue": {
      "description": "Project-owned normalized JSON-like value. No credential-bearing keys.",
      "oneOf": [
        { "type": "null" },
        { "type": "boolean" },
        { "type": "string" },
        { "type": "number" },
        {
          "type": "array",
          "items": { "$ref": "#/$defs/canonicalValue" }
        },
        {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/canonicalValue" },
          "propertyNames": { "$ref": "#/$defs/safePropertyName" }
        }
      ]
    },
    "safePropertyName": {
      "type": "string",
      "not": {
        "pattern": "(?i)(password|secret|token|api[_-]?key|private[_-]?key|authorization|bearer)"
      }
    },
    "projectorFixture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "minLength": 1 }
      }
    },
    "pdpFixture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "minLength": 1 }
      }
    },
    "integrityMutation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "NONE",
            "TOOL_NAME",
            "MAPPED_ARGUMENT",
            "METHOD",
            "MAPPED_TRUSTED_CONTEXT",
            "JSON_REORDER_ONLY",
            "UNMAPPED_FIELD"
          ]
        },
        "detail": { "type": "string", "minLength": 1 }
      }
    },
    "vectorExpectation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enforcement"],
      "properties": {
        "enforcement": { "$ref": "#/$defs/expectedEnforcement" }
      }
    },
    "expectedEnforcement": {
      "type": "string",
      "enum": [
        "FORWARD_WITH_EXISTING_PERMIT",
        "REEVALUATE_OR_REFUSE",
        "PERMIT_REMAINS_BOUND"
      ]
    },
    "safetyConstraints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["synthetic_only"],
      "properties": {
        "synthetic_only": { "type": "boolean" },
        "reference_mode": {
          "type": "string",
          "enum": ["SECURE_REEVALUATE", "SECURE_REFUSE", "VULNERABLE_REUSE"]
        }
      }
    }
  }
}
