{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://darelabs.tech/schemas/product/v1/summary.schema.json",
  "title": "DARE Product Summary v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "run_id",
    "project_name",
    "profile",
    "profile_version",
    "gate",
    "overall_coverage",
    "required_coverage",
    "severity_counts",
    "top_finding_ids",
    "attack_path_summary",
    "validation_status",
    "limitations",
    "classification",
    "privacy_mode",
    "offline",
    "generated_at"
  ],
  "properties": {
    "schema_id": { "type": "string" },
    "schema_version": { "type": "string" },
    "run_id": { "type": "string" },
    "project_name": { "type": "string" },
    "profile": { "type": "string" },
    "profile_version": { "type": "string" },
    "gate": {
      "type": "string",
      "enum": ["PASS", "FAIL", "PARTIAL", "BLOCKED", "INCONCLUSIVE"]
    },
    "overall_coverage": { "type": "number", "minimum": 0, "maximum": 1 },
    "required_coverage": { "type": "number", "minimum": 0, "maximum": 1 },
    "severity_counts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "critical": { "type": "integer", "minimum": 0 },
        "high": { "type": "integer", "minimum": 0 },
        "medium": { "type": "integer", "minimum": 0 },
        "low": { "type": "integer", "minimum": 0 },
        "info": { "type": "integer", "minimum": 0 }
      }
    },
    "top_finding_ids": { "type": "array", "items": { "type": "string" } },
    "attack_path_summary": { "type": "string" },
    "validation_status": { "type": "string" },
    "limitations": { "type": "array", "items": { "type": "string" } },
    "classification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "distribution", "publication_allowed"],
      "properties": {
        "level": { "type": "string" },
        "distribution": { "type": "array", "items": { "type": "string" } },
        "publication_allowed": { "type": "boolean" }
      }
    },
    "privacy_mode": { "type": "string" },
    "offline": { "type": "boolean" },
    "generated_at": { "type": "string" }
  }
}
