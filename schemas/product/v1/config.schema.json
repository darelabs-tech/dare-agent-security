{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://darelabs.tech/schemas/product/v1/config.schema.json",
  "title": "DARE Product Config v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "project"],
  "properties": {
    "version": { "type": "string", "pattern": "^1(\\..*)?$" },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1 }
      }
    },
    "assessment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "profile": { "type": "string", "minLength": 1 }
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": { "type": "string", "enum": ["standard", "confidential"] },
        "telemetry": { "type": "boolean" },
        "network": { "type": "string", "enum": ["restricted", "denied", "allowlisted"] },
        "offline": { "type": "boolean" },
        "retention_days": { "type": ["integer", "null"], "minimum": 1 }
      }
    },
    "reporting": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "formats": {
          "type": "array",
          "items": { "type": "string", "enum": ["html", "json"] }
        }
      }
    },
    "classification": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "level": { "type": "string" },
        "distribution": { "type": "array", "items": { "type": "string" } },
        "publication_allowed": { "type": "boolean" }
      }
    }
  }
}
