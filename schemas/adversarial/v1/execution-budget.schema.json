{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://darelabs.tech/schemas/adversarial/v1/execution-budget.schema.json",
  "title": "DARE Adversarial Execution Budget v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "max_operations", "max_duration_seconds", "max_state_changes", "max_bytes_read", "max_bytes_written", "max_external_egress_bytes", "max_retries", "max_chain_depth"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "max_operations": { "type": "integer", "minimum": 0, "maximum": 1000 },
    "max_duration_seconds": { "type": "integer", "minimum": 1, "maximum": 3600 },
    "max_state_changes": { "type": "integer", "minimum": 0, "maximum": 100 },
    "max_bytes_read": { "type": "integer", "minimum": 0, "maximum": 104857600 },
    "max_bytes_written": { "type": "integer", "minimum": 0, "maximum": 104857600 },
    "max_external_egress_bytes": { "type": "integer", "minimum": 0, "maximum": 104857600 },
    "max_retries": { "type": "integer", "minimum": 0, "maximum": 100 },
    "max_chain_depth": { "type": "integer", "minimum": 0, "maximum": 64 }
  }
}
