{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://darelabs.tech/schemas/adversarial/v1/test-vector.schema.json",
  "title": "DARE Adversarial Test Vector v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "mode", "preconditions", "steps", "expected_secure", "expected_vulnerable", "stop_on_first_proof"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "mode": { "enum": ["PLAN_ONLY", "SIMULATED", "LOCAL_SYNTHETIC", "AUTHORIZED_DYNAMIC"] },
    "preconditions": {
      "type": "array",
      "maxItems": 32,
      "items": { "type": "string", "minLength": 1, "maxLength": 256 }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["method", "capability", "arguments", "safety_class", "synthetic_observation"],
        "properties": {
          "method": { "type": "string", "minLength": 1, "maxLength": 128 },
          "capability": { "type": "string", "minLength": 1, "maxLength": 256 },
          "arguments": { "type": "object", "maxProperties": 64 },
          "safety_class": { "enum": ["READ_ONLY", "SYNTHETIC_NOOP", "DRY_RUN"] },
          "synthetic_observation": { "enum": ["ALLOW", "DENY", "INCONCLUSIVE"] },
          "bytes_read": { "type": "integer", "minimum": 0 },
          "bytes_written": { "type": "integer", "minimum": 0 },
          "state_changes": { "type": "integer", "minimum": 0 },
          "external_egress_bytes": { "type": "integer", "minimum": 0 },
          "retries": { "type": "integer", "minimum": 0 },
          "target_id": { "type": ["string", "null"], "maxLength": 256 },
          "identity_id": { "type": ["string", "null"], "maxLength": 256 },
          "trigger": {
            "type": ["string", "null"],
            "enum": [null, "UNEXPECTED_STATE", "UNEXPECTED_EGRESS", "UNEXPECTED_TARGET", "UNEXPECTED_IDENTITY", "SECRET_DETECTED", "TARGET_INSTABILITY", "EVIDENCE_FAILURE", "OPERATOR_STOP"]
          }
        }
      }
    },
    "expected_secure": { "enum": ["ALLOW", "DENY", "INCONCLUSIVE"] },
    "expected_vulnerable": { "enum": ["ALLOW", "DENY", "INCONCLUSIVE"] },
    "stop_on_first_proof": { "type": "boolean" }
  }
}
