{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://darelabs.tech/schemas/runtime-telemetry/v1/result.schema.json",
  "title": "DARE runtime-telemetry result",
  "description": "Verdicts per property over supplied OTLP trace exports. Carries keys, ids, reason codes and digests only; never an attribute value. No wall-clock time.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "schema_id", "engine", "mode", "synthetic", "semconv", "inputs", "max_spans", "traces", "properties", "verdict", "reason", "redaction_state", "bounded_claim"],
  "properties": {
    "schema_version": {"const": "1"},
    "schema_id": {"const": "https://darelabs.tech/schemas/runtime-telemetry/v1/result.schema.json"},
    "engine": {"const": "runtime-telemetry"},
    "mode": {"enum": ["REPLAY", "SIMULATED"]},
    "synthetic": {"type": "boolean"},
    "semconv": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mapping_id", "mapping_digest", "core_release", "genai_release"],
      "properties": {
        "mapping_id": {"type": "string"},
        "mapping_digest": {"$ref": "#/$defs/digest"},
        "core_release": {"type": "string"},
        "genai_release": {"type": "string"}
      }
    },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trace_files"],
      "properties": {
        "trace_files": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["index", "digest", "spans", "unknown_fields"],
            "properties": {
              "index": {"type": "integer", "minimum": 0},
              "digest": {"$ref": "#/$defs/digest"},
              "spans": {"type": "integer", "minimum": 0},
              "unknown_fields": {"type": "integer", "minimum": 0}
            }
          }
        },
        "policy_id": {"type": "string"},
        "policy_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "max_spans": {"type": "integer", "minimum": 1, "maximum": 1000000},
    "stop_reason": {"enum": ["max_spans"]},
    "traces": {
      "type": "object",
      "additionalProperties": false,
      "required": ["count", "spans", "duplicates_removed", "spans_by_kind", "unrecognized_keys", "incomplete"],
      "properties": {
        "count": {"type": "integer", "minimum": 0},
        "spans": {"type": "integer", "minimum": 0},
        "duplicates_removed": {"type": "integer", "minimum": 0},
        "spans_by_kind": {
          "type": "object",
          "propertyNames": {"$ref": "#/$defs/spanKind"},
          "additionalProperties": {"type": "integer", "minimum": 0}
        },
        "unrecognized_keys": {"type": "integer", "minimum": 0},
        "incomplete": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["trace_id", "gaps"],
            "properties": {
              "trace_id": {"$ref": "#/$defs/traceId"},
              "gaps": {"type": "array", "items": {"$ref": "#/$defs/gap"}}
            }
          }
        }
      }
    },
    "properties": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["rule", "property_id", "coverage", "reason", "traces", "gaps", "evidence_ids"],
        "properties": {
          "rule": {"$ref": "#/$defs/rule"},
          "property_id": {"type": "string", "pattern": "^AGENT\\.[A-Z_]+\\.[A-Z_]+$"},
          "verdict": {"$ref": "#/$defs/verdict"},
          "coverage": {"enum": ["APPLICABLE", "NOT_APPLICABLE", "NOT_TESTED"]},
          "reason": {"enum": ["no_runtime_policy", "observed_violation", "incomplete_traces", "required_operation_unobserved", "observed_conformant", "not_exercised"]},
          "traces": {
            "type": "object",
            "additionalProperties": false,
            "required": ["fail", "inconclusive", "pass", "not_exercised"],
            "properties": {
              "fail": {"type": "integer", "minimum": 0},
              "inconclusive": {"type": "integer", "minimum": 0},
              "pass": {"type": "integer", "minimum": 0},
              "not_exercised": {"type": "integer", "minimum": 0}
            }
          },
          "gaps": {"type": "array", "items": {"$ref": "#/$defs/gap"}},
          "evidence_ids": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "verdict": {"$ref": "#/$defs/verdict"},
    "reason": {"enum": ["a_property_failed", "a_property_is_undecided", "every_judged_property_passed", "nothing_judged"]},
    "redaction_state": {"const": "REDACTED"},
    "bounded_claim": {"type": "string"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "traceId": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
    "verdict": {"enum": ["PASS", "FAIL", "INCONCLUSIVE", "ERROR"]},
    "rule": {"enum": ["B-1", "B-2", "B-3", "B-4R", "B-4M", "B-5", "B-6", "T-1", "T-2"]},
    "spanKind": {"enum": ["AGENT_INVOKE", "MODEL_CALL", "TOOL_EXEC", "RETRIEVAL", "MEMORY", "MCP_CALL", "HTTP_CLIENT", "UNRECOGNIZED"]},
    "gap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reason"],
      "properties": {
        "reason": {"enum": ["orphan", "conflict", "malformed", "too_deep", "missing_root", "time_inversion", "dropped_attributes", "dropped_events", "dropped_links", "not_sampled", "no_observation", "missing_key", "span_bound", "oversize_value"]},
        "key": {"type": "string", "maxLength": 512}
      }
    }
  }
}
