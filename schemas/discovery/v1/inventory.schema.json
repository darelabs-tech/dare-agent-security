{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://darelabs.tech/schemas/discovery/v1/inventory.schema.json",
  "title": "DARE Agent Security Discovery Inventory v1",
  "description": "Versioned, machine-readable passive MCP discovery inventory. Structural validation only; semantic invariants are enforced by the Rust library.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "generated_at",
    "completeness",
    "target",
    "protocol",
    "transport",
    "capabilities",
    "auth",
    "tools",
    "resources",
    "resource_templates",
    "prompts",
    "indicators",
    "warnings",
    "redaction",
    "hashes"
  ],
  "properties": {
    "schema": { "$ref": "#/$defs/schemaRef" },
    "generated_at": { "type": "string", "format": "date-time" },
    "completeness": { "$ref": "#/$defs/completeness" },
    "target": { "$ref": "#/$defs/discoveryTarget" },
    "protocol": { "$ref": "#/$defs/protocolSnapshot" },
    "transport": { "$ref": "#/$defs/transportSnapshot" },
    "server": { "$ref": "#/$defs/serverSnapshot" },
    "capabilities": { "$ref": "#/$defs/capabilitySnapshot" },
    "auth": { "$ref": "#/$defs/authSnapshot" },
    "tools": {
      "type": "array",
      "items": { "$ref": "#/$defs/toolInventory" }
    },
    "resources": {
      "type": "array",
      "items": { "$ref": "#/$defs/resourceInventory" }
    },
    "resource_templates": {
      "type": "array",
      "items": { "$ref": "#/$defs/resourceTemplateInventory" }
    },
    "prompts": {
      "type": "array",
      "items": { "$ref": "#/$defs/promptInventory" }
    },
    "indicators": {
      "type": "array",
      "items": { "$ref": "#/$defs/baselineIndicator" }
    },
    "warnings": {
      "type": "array",
      "items": { "$ref": "#/$defs/discoveryWarning" }
    },
    "redaction": { "$ref": "#/$defs/discoveryRedaction" },
    "hashes": {
      "type": "array",
      "items": { "$ref": "#/$defs/hashRef" }
    },
    "scanner": { "$ref": "#/$defs/scannerMetadata" }
  },
  "$defs": {
    "schemaRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "const": "https://darelabs.tech/schemas/discovery"
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        }
      }
    },
    "completeness": {
      "type": "string",
      "enum": ["COMPLETE", "PARTIAL"]
    },
    "discoveryTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "display_name": { "type": "string", "minLength": 1 },
        "endpoint_fingerprint": { "type": "string", "minLength": 1 }
      }
    },
    "protocolSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revision", "negotiated"],
      "properties": {
        "revision": { "type": "string", "minLength": 1 },
        "negotiated": { "type": "boolean" },
        "client_name": { "type": "string", "minLength": 1 },
        "client_version": { "type": "string", "minLength": 1 }
      }
    },
    "transportSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["STDIO", "STREAMABLE_HTTP"]
        },
        "identity": { "type": "string", "minLength": 1 }
      }
    },
    "serverSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 }
      }
    },
    "capabilitySnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tools", "resources", "resource_templates", "prompts"],
      "properties": {
        "tools": { "type": "boolean" },
        "resources": { "type": "boolean" },
        "resource_templates": { "type": "boolean" },
        "prompts": { "type": "boolean" }
      }
    },
    "authSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "mechanism"],
      "properties": {
        "state": {
          "type": "string",
          "enum": ["OBSERVED", "DECLARED", "UNKNOWN", "NOT_APPLICABLE"]
        },
        "mechanism": {
          "type": "string",
          "enum": [
            "NONE_OBSERVED",
            "OAUTH_METADATA",
            "BEARER_CONFIGURED",
            "API_KEY_CONFIGURED",
            "MUTUAL_TLS_CONFIGURED",
            "OTHER",
            "UNKNOWN"
          ]
        }
      }
    },
    "toolInventory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "input_schema_digest": { "$ref": "#/$defs/hashRef" },
        "input_schema": {
          "type": "object",
          "description": "Bounded JSON object captured as metadata. Never executed as a server-supplied validator."
        },
        "annotations": { "$ref": "#/$defs/toolAnnotations" },
        "classification": { "$ref": "#/$defs/toolClassification" }
      }
    },
    "toolAnnotations": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "read_only_hint": { "type": "boolean" },
        "destructive_hint": { "type": "boolean" },
        "idempotent_hint": { "type": "boolean" },
        "open_world_hint": { "type": "boolean" }
      }
    },
    "toolClassification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["class", "source", "rationale_code", "heuristic_indicators"],
      "properties": {
        "class": {
          "type": "string",
          "enum": ["READ_ONLY", "STATE_CHANGING", "DESTRUCTIVE", "UNKNOWN"]
        },
        "source": {
          "type": "string",
          "enum": [
            "PROTOCOL_ANNOTATION",
            "EXPLICIT_CONFIGURATION",
            "DETERMINISTIC_DERIVATION",
            "INSUFFICIENT_METADATA"
          ]
        },
        "rationale_code": { "type": "string", "minLength": 1 },
        "heuristic_indicators": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "resourceInventory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uri"],
      "properties": {
        "uri": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "mime_type": { "type": "string", "minLength": 1 }
      }
    },
    "resourceTemplateInventory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uri_template"],
      "properties": {
        "uri_template": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 }
      }
    },
    "promptInventory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 }
      }
    },
    "baselineIndicator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "code", "message"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "code": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 }
      }
    },
    "discoveryWarning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "ITEM_LIMIT_REACHED",
            "MALFORMED_METADATA",
            "PAGINATION_LIMIT_REACHED",
            "REDACTION_APPLIED",
            "RESPONSE_LIMIT_REACHED",
            "TIMEOUT",
            "UNSUPPORTED_CAPABILITY",
            "UNSUPPORTED_PROTOCOL"
          ]
        },
        "message": { "type": "string", "minLength": 1 }
      }
    },
    "discoveryRedaction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["applied", "strategy"],
      "properties": {
        "applied": { "type": "boolean" },
        "strategy": {
          "type": "string",
          "enum": ["NONE", "PARTIAL", "FULL"]
        }
      }
    },
    "hashRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["alg", "digest"],
      "properties": {
        "alg": {
          "type": "string",
          "enum": ["sha256", "sha384", "sha512"]
        },
        "digest": {
          "type": "string",
          "pattern": "^[0-9a-f]+$",
          "minLength": 64,
          "maxLength": 128
        }
      }
    },
    "scannerMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    }
  }
}
