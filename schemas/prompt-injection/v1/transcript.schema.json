{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://darelabs.tech/schemas/prompt-injection/v1/transcript.schema.json",
  "title": "DARE Prompt Injection Replay Transcript v1",
  "description": "A sanitized, local record of agent behavior for offline replay. Replay invokes no model and performs no network I/O; the transcript is inert data.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "scenario_id", "trials"],
  "properties": {
    "schema_version": { "const": "1" },
    "scenario_id": {
      "type": "string",
      "pattern": "^PI-[A-Z0-9]+(-[A-Z0-9]+)*$",
      "maxLength": 64
    },
    "recorded_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "note": { "type": "string", "maxLength": 300 },
    "trials": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["index"],
        "properties": {
          "index": { "type": "integer", "minimum": 0, "maximum": 9 },
          "output_text": { "type": "string", "maxLength": 16384 },
          "goal_id": {
            "type": "string",
            "pattern": "^goal-[a-z0-9]+(-[a-z0-9]+)*$",
            "maxLength": 96
          },
          "actions": {
            "type": "array",
            "maxItems": 32,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["action"],
              "properties": {
                "action": {
                  "type": "string",
                  "pattern": "^[a-z0-9]+(\\.[a-z0-9_]+)+$",
                  "maxLength": 96
                },
                "arguments_digest": {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                }
              }
            }
          },
          "policy_decisions": {
            "type": "array",
            "maxItems": 32,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["operation", "outcome"],
              "properties": {
                "operation": {
                  "type": "string",
                  "pattern": "^[a-z0-9]+(\\.[a-z0-9_]+)+$",
                  "maxLength": 96
                },
                "outcome": {
                  "type": "string",
                  "enum": ["ALLOW", "DENY", "NOT_EVALUATED"]
                },
                "policy_id": { "type": "string", "maxLength": 96 }
              }
            }
          },
          "emitted_fields": {
            "type": "array",
            "maxItems": 64,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9]+(_[a-z0-9]+)*$",
              "maxLength": 64
            }
          },
          "harness_error": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "detail"],
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "ADAPTER_FAILURE",
                  "MALFORMED_TRANSCRIPT",
                  "BUDGET_EXHAUSTED",
                  "TIMEOUT",
                  "SCHEMA_VIOLATION"
                ]
              },
              "detail": { "type": "string", "maxLength": 300 }
            }
          }
        }
      }
    }
  }
}
