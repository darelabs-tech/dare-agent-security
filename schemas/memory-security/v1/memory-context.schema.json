{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://darelabs.tech/schemas/memory-security/v1/memory-context.schema.json",
  "title": "DARE Memory Security Principal Context v1",
  "description": "The principal, tenant and namespace a memory operation runs under. Principal kinds are the Cycle 015 ones, reused rather than redefined.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "context_id",
    "principals",
    "acting_principal_id",
    "tenant_id",
    "namespace_id"
  ],
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "context_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+([-_.][a-z0-9]+)*$",
      "minLength": 2,
      "maxLength": 96
    },
    "principals": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "principal_id",
          "kind",
          "tenant_id"
        ],
        "properties": {
          "principal_id": {
            "type": "string",
            "pattern": "^[a-z0-9]+([-_.][a-z0-9]+)*$",
            "minLength": 2,
            "maxLength": 96
          },
          "kind": {
            "type": "string",
            "enum": [
              "HUMAN",
              "AGENT",
              "WORKLOAD",
              "SERVICE"
            ]
          },
          "tenant_id": {
            "type": "string",
            "pattern": "^[a-z0-9]+([-_.][a-z0-9]+)*$",
            "minLength": 2,
            "maxLength": 96
          },
          "namespaces": {
            "type": "array",
            "maxItems": 8,
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9]+([-_.][a-z0-9]+)*$",
              "minLength": 2,
              "maxLength": 96
            }
          },
          "display_label": {
            "type": "string",
            "maxLength": 96
          }
        }
      }
    },
    "acting_principal_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+([-_.][a-z0-9]+)*$",
      "minLength": 2,
      "maxLength": 96
    },
    "tenant_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+([-_.][a-z0-9]+)*$",
      "minLength": 2,
      "maxLength": 96
    },
    "namespace_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+([-_.][a-z0-9]+)*$",
      "minLength": 2,
      "maxLength": 96
    }
  }
}
