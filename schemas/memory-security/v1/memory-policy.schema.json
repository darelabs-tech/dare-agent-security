{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://darelabs.tech/schemas/memory-security/v1/memory-policy.schema.json",
  "title": "DARE Memory Security Memory Policy v1",
  "description": "A declarative memory policy. Sets, an ordered trust ceiling and explicit elevation grants — no expression language, callback, regex-as-code, shell or external policy call, because a policy that could execute would be a second unreviewed engine.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "policy_id",
    "max_trust_class"
  ],
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "policy_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+([-_.][a-z0-9]+)*$",
      "minLength": 2,
      "maxLength": 96
    },
    "title": {
      "type": "string",
      "maxLength": 200
    },
    "allowed_writers": {
      "description": "A closed policy dimension. ANY must be written explicitly; an omitted dimension permits nothing, so forgetting a field can never widen a policy. ANY carries no values and ONLY must carry them, so the two forms cannot be confused.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "constraint"
      ],
      "properties": {
        "constraint": {
          "type": "string",
          "enum": [
            "ANY",
            "ONLY"
          ]
        },
        "values": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "string",
            "maxLength": 96
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "constraint": {
                "const": "ONLY"
              }
            },
            "required": [
              "constraint"
            ]
          },
          "then": {
            "required": [
              "values"
            ]
          },
          "else": {
            "not": {
              "required": [
                "values"
              ]
            }
          }
        }
      ]
    },
    "allowed_readers": {
      "description": "A closed policy dimension. ANY must be written explicitly; an omitted dimension permits nothing, so forgetting a field can never widen a policy. ANY carries no values and ONLY must carry them, so the two forms cannot be confused.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "constraint"
      ],
      "properties": {
        "constraint": {
          "type": "string",
          "enum": [
            "ANY",
            "ONLY"
          ]
        },
        "values": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "string",
            "maxLength": 96
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "constraint": {
                "const": "ONLY"
              }
            },
            "required": [
              "constraint"
            ]
          },
          "then": {
            "required": [
              "values"
            ]
          },
          "else": {
            "not": {
              "required": [
                "values"
              ]
            }
          }
        }
      ]
    },
    "allowed_tenants": {
      "description": "A closed policy dimension. ANY must be written explicitly; an omitted dimension permits nothing, so forgetting a field can never widen a policy. ANY carries no values and ONLY must carry them, so the two forms cannot be confused.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "constraint"
      ],
      "properties": {
        "constraint": {
          "type": "string",
          "enum": [
            "ANY",
            "ONLY"
          ]
        },
        "values": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "string",
            "maxLength": 96
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "constraint": {
                "const": "ONLY"
              }
            },
            "required": [
              "constraint"
            ]
          },
          "then": {
            "required": [
              "values"
            ]
          },
          "else": {
            "not": {
              "required": [
                "values"
              ]
            }
          }
        }
      ]
    },
    "allowed_namespaces": {
      "description": "A closed policy dimension. ANY must be written explicitly; an omitted dimension permits nothing, so forgetting a field can never widen a policy. ANY carries no values and ONLY must carry them, so the two forms cannot be confused.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "constraint"
      ],
      "properties": {
        "constraint": {
          "type": "string",
          "enum": [
            "ANY",
            "ONLY"
          ]
        },
        "values": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "string",
            "maxLength": 96
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "constraint": {
                "const": "ONLY"
              }
            },
            "required": [
              "constraint"
            ]
          },
          "then": {
            "required": [
              "values"
            ]
          },
          "else": {
            "not": {
              "required": [
                "values"
              ]
            }
          }
        }
      ]
    },
    "allowed_source_kinds": {
      "description": "Source kinds that may be persisted. An empty or absent list does not constrain source kinds; constraining them to nothing would make a policy unusable rather than strict.",
      "type": "array",
      "maxItems": 6,
      "items": {
        "type": "string",
        "enum": [
          "USER_INPUT",
          "TOOL_OUTPUT",
          "EXTERNAL_CONTENT",
          "SYSTEM_AUTHORED",
          "AGENT_GENERATED",
          "IMPORTED_CONTEXT"
        ]
      }
    },
    "max_trust_class": {
      "type": "string",
      "enum": [
        "UNTRUSTED",
        "CONSTRAINED",
        "TRUSTED_POLICY"
      ]
    },
    "allowed_objective_ids": {
      "description": "A closed policy dimension. ANY must be written explicitly; an omitted dimension permits nothing, so forgetting a field can never widen a policy. ANY carries no values and ONLY must carry them, so the two forms cannot be confused.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "constraint"
      ],
      "properties": {
        "constraint": {
          "type": "string",
          "enum": [
            "ANY",
            "ONLY"
          ]
        },
        "values": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "string",
            "maxLength": 96
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "constraint": {
                "const": "ONLY"
              }
            },
            "required": [
              "constraint"
            ]
          },
          "then": {
            "required": [
              "values"
            ]
          },
          "else": {
            "not": {
              "required": [
                "values"
              ]
            }
          }
        }
      ]
    },
    "protected_fields": {
      "description": "Fields memory may never populate, whatever its trust class.",
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+([-_.][a-z0-9]+)*$",
        "minLength": 2,
        "maxLength": 96
      }
    },
    "trust_elevation_grants": {
      "description": "The only machine-readable route above a source's default trust ceiling. Each grant names one specific origin; a blanket grant over a whole source kind would re-open the boundary.",
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_kind",
          "source_id",
          "granted_trust_class"
        ],
        "properties": {
          "source_kind": {
            "type": "string",
            "enum": [
              "USER_INPUT",
              "TOOL_OUTPUT",
              "EXTERNAL_CONTENT",
              "SYSTEM_AUTHORED",
              "AGENT_GENERATED",
              "IMPORTED_CONTEXT"
            ]
          },
          "source_id": {
            "type": "string",
            "pattern": "^[a-z0-9]+([-_.][a-z0-9]+)*$",
            "minLength": 2,
            "maxLength": 96
          },
          "granted_trust_class": {
            "type": "string",
            "enum": [
              "UNTRUSTED",
              "CONSTRAINED",
              "TRUSTED_POLICY"
            ]
          }
        }
      }
    }
  }
}
