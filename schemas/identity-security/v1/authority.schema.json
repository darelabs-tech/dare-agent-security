            "constraint"
          ],
          "additionalProperties": false
        },
        {
          "properties": {
            "constraint": {
              "const": "ONLY"
            },
            "values": {
              "type": "array",
              "maxItems": 64,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9 ._:/-]{0,127}$"
              }
            }
