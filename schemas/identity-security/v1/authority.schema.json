      "maxLength": 96
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "actions": {
      "description": "One authority dimension. ANY must be written explicitly; an omitted dimension permits nothing, because absence of a rule is never permission.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "constraint"
      ],
      "oneOf": [
        {
          "properties": {
            "constraint": {
              "const": "ANY"
