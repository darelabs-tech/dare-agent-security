{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://darelabs.tech/schemas/identity-security/v1/principal-set.schema.json",
  "title": "DARE Identity Security Principal Set v1",
  "description": "A bounded set of synthetic principals plus their role bindings. Principals are declarative metadata; no token, credential or secret field is accepted.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "set_id",
    "principals",
    "bindings"
  ],
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "set_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+([-_.][a-z0-9]+)*$",
      "minLength": 3,
      "maxLength": 96
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "principals": {
      "description": "Bounded at the approved hard maximum of 16 principals.",
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+([-_.][a-z0-9]+)*$",
            "minLength": 2,
            "maxLength": 96
          },
          "kind": {
            "type": "string",
            "enum": [
              "HUMAN",
              "AGENT",
              "WORKLOAD",
              "SERVICE"
            ]
          },
          "display_label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "tenant_id": {
            "type": "string",
            "pattern": "^[a-z0-9]+([-_.][a-z0-9]+)*$",
            "maxLength": 96
          },
          "roles": {
            "type": "array",
            "maxItems": 32,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9 ._:/-]{0,127}$"
            }
          },
          "authority_ceiling_id": {
            "type": "string",
            "pattern": "^[a-z0-9]+([-_.][a-z0-9]+)*$",
            "maxLength": 96
          }
        }
      }
    },
    "bindings": {
      "description": "Initiating and effective are required: defaulting either would invent the answer the principal invariants ask for.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "initiating_principal_id",
        "effective_principal_id"
      ],
      "properties": {
        "initiating_principal_id": {
          "type": "string",
          "pattern": "^[a-z0-9]+([-_.][a-z0-9]+)*$",
          "maxLength": 96
        },
        "effective_principal_id": {
          "type": "string",
          "pattern": "^[a-z0-9]+([-_.][a-z0-9]+)*$",
          "maxLength": 96
        },
        "agent_principal_id": {
          "type": "string",
          "pattern": "^[a-z0-9]+([-_.][a-z0-9]+)*$",
          "maxLength": 96
        },
        "delegated_subject_id": {
          "type": "string",
          "pattern": "^[a-z0-9]+([-_.][a-z0-9]+)*$",
          "maxLength": 96
        },
        "resource_owner_id": {
          "type": "string",
          "pattern": "^[a-z0-9]+([-_.][a-z0-9]+)*$",
          "maxLength": 96
        }
      }
    }
  }
}
