{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://darelabs.tech/schemas/mcp-auth-security/v1/trace.schema.json",
  "title": "DARE Cycle 018 MCP auth-security replay trace",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "trace_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "scenario_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "mode": {
      "const": "REPLAY"
    },
    "synthetic": {
      "const": true
    },
    "description": {
      "type": "string"
    },
    "trials": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "observed_requests": {
            "type": "array",
            "maxItems": 8,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "request_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "protocol": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "declared_revision": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 256
                    },
                    "http_transport": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "declared_revision"
                  ]
                },
                "headers": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "method": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 256
                    },
                    "name": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 256
                    }
                  }
                },
                "operation": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "method": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 256
                    },
                    "name": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 256
                    }
                  },
                  "required": [
                    "method"
                  ]
                }
              },
              "required": [
                "request_id",
                "protocol",
                "operation"
              ]
            }
          },
          "harness_error": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "ADAPTER_FAILURE",
                  "STAGING_FAILURE",
                  "KILL_SWITCH_TRIGGERED",
                  "BUDGET_EXHAUSTED"
                ]
              },
              "detail": {
                "type": "string"
              }
            },
            "required": [
              "kind",
              "detail"
            ]
          }
        }
      }
    }
  },
  "required": [
    "schema_version",
    "trace_id",
    "scenario_id",
    "mode",
    "synthetic",
    "trials"
  ]
}
