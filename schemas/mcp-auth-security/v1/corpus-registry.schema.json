{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://darelabs.tech/schemas/mcp-auth-security/v1/corpus-registry.schema.json",
  "title": "DARE Cycle 018 MCP auth-security corpus registry",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "corpus_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "title": {
      "type": "string"
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "path": {
            "type": "string",
            "pattern": "^(?!.*(\\.\\.|://|^/))[A-Za-z0-9._/-]+\\.json$"
          },
          "digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        },
        "required": [
          "id",
          "path"
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "corpus_id",
    "version",
    "entries"
  ]
}
