{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://darelabs.tech/schemas/evidence/v1/evidence.schema.json",
  "title": "DARE Agent Security Evidence v1",
  "description": "Protocol-neutral, versioned security evidence contract. Structural validation only; semantic invariants are enforced by the Rust kernel.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "vector",
    "target",
    "preconditions",
    "expected",
    "observed",
    "verdict",
    "redaction",
    "timestamps"
  ],
  "properties": {
    "schema": { "$ref": "#/$defs/schemaRef" },
    "id": { "type": "string", "minLength": 1 },
    "vector": { "$ref": "#/$defs/vectorRef" },
    "target": { "$ref": "#/$defs/targetRef" },
    "preconditions": {
      "type": "array",
      "items": { "$ref": "#/$defs/precondition" }
    },
    "operation": { "$ref": "#/$defs/normalizedOperation" },
    "authorization_context": { "$ref": "#/$defs/authorizationContext" },
    "expected": { "$ref": "#/$defs/expectedOutcome" },
    "observed": { "$ref": "#/$defs/observedOutcome" },
    "verdict": { "$ref": "#/$defs/verdict" },
    "severity": { "$ref": "#/$defs/severityAssessment" },
    "standards": {
      "type": "array",
      "items": { "$ref": "#/$defs/standardMapping" }
    },
    "artifacts": {
      "type": "array",
      "items": { "$ref": "#/$defs/evidenceArtifactRef" }
    },
    "hashes": {
      "type": "array",
      "items": { "$ref": "#/$defs/hashRef" }
    },
    "redaction": { "$ref": "#/$defs/redactionMetadata" },
    "timestamps": { "$ref": "#/$defs/evidenceTimestamps" },
    "extensions": {
      "type": "object",
      "description": "Namespaced extension container. Keys must contain a '.' (e.g. org.example.mcp).",
      "additionalProperties": true,
      "propertyNames": {
        "type": "string",
        "minLength": 3,
        "pattern": "^[a-z0-9][a-z0-9.-]*\\.[a-z0-9.-]+$"
      }
    }
  },
  "$defs": {
    "schemaRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "const": "https://darelabs.tech/schemas/evidence"
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        }
      }
    },
    "vectorRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 }
      }
    },
    "targetRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id"],
      "properties": {
        "type": { "type": "string", "minLength": 1 },
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "software": { "type": "string", "minLength": 1 },
        "software_version": { "type": "string", "minLength": 1 },
        "protocol": { "type": "string", "minLength": 1 },
        "protocol_version": { "type": "string", "minLength": 1 }
      }
    },
    "precondition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description", "satisfied"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "satisfied": { "type": "boolean" }
      }
    },
    "normalizedOperation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "name"],
      "properties": {
        "kind": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "resource": { "type": "string", "minLength": 1 },
        "arguments_digest": { "$ref": "#/$defs/hashRef" },
        "attributes": { "$ref": "#/$defs/genericMap" }
      }
    },
    "authorizationContext": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "principal_id": { "type": "string", "minLength": 1 },
        "agent_id": { "type": "string", "minLength": 1 },
        "authn_method": { "type": "string", "minLength": 1 },
        "policy_id": { "type": "string", "minLength": 1 },
        "policy_version": { "type": "string", "minLength": 1 },
        "context_attributes": { "$ref": "#/$defs/genericMap" }
      }
    },
    "expectedOutcome": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "decision": { "$ref": "#/$defs/decision" },
        "result": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 }
      }
    },
    "observedOutcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source"],
      "properties": {
        "decision": { "$ref": "#/$defs/decision" },
        "result": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "source": { "$ref": "#/$defs/observationSource" }
      }
    },
    "decision": {
      "type": "string",
      "enum": [
        "ALLOW",
        "DENY",
        "RE_EVALUATE",
        "REQUIRES_APPROVAL",
        "NOT_APPLICABLE"
      ]
    },
    "observationSource": {
      "type": "string",
      "enum": [
        "PROTOCOL_RESPONSE",
        "POLICY_ENGINE",
        "RUNTIME_EVENT",
        "FIXTURE"
      ]
    },
    "verdict": {
      "type": "string",
      "enum": ["PASS", "FAIL", "INCONCLUSIVE", "ERROR"]
    },
    "severityAssessment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "rationale"],
      "properties": {
        "level": {
          "type": "string",
          "enum": ["INFO", "LOW", "MEDIUM", "HIGH", "CRITICAL"]
        },
        "rationale": { "type": "string", "minLength": 1 }
      }
    },
    "standardMapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["organization", "standard", "control"],
      "properties": {
        "organization": { "type": "string", "minLength": 1 },
        "standard": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "control": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "minLength": 1 }
      }
    },
    "evidenceArtifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "uri_or_path", "redacted"],
      "properties": {
        "type": { "type": "string", "minLength": 1 },
        "uri_or_path": { "type": "string", "minLength": 1 },
        "digest": { "$ref": "#/$defs/hashRef" },
        "media_type": { "type": "string", "minLength": 1 },
        "redacted": { "type": "boolean" }
      }
    },
    "hashRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "value"],
      "properties": {
        "algorithm": {
          "type": "string",
          "enum": ["sha256", "sha384", "sha512"]
        },
        "value": {
          "type": "string",
          "pattern": "^[0-9a-f]+$",
          "minLength": 64,
          "maxLength": 128
        }
      }
    },
    "redactionMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["applied", "strategy"],
      "properties": {
        "applied": { "type": "boolean" },
        "strategy": {
          "type": "string",
          "enum": [
            "NONE_REQUIRED",
            "REMOVE",
            "MASK",
            "HASH",
            "TOKENIZE",
            "MIXED"
          ]
        },
        "fields": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "evidenceTimestamps": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observed_at", "recorded_at"],
      "properties": {
        "started_at": { "type": "string", "format": "date-time" },
        "observed_at": { "type": "string", "format": "date-time" },
        "recorded_at": { "type": "string", "format": "date-time" }
      }
    },
    "genericMap": {
      "type": "object",
      "description": "Generic attribute map. High-risk credential keys are rejected by semantic validation, not by this schema.",
      "additionalProperties": true
    }
  }
}
