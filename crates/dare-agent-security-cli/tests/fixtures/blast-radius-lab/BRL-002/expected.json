{
  "exit": 2,
  "seeds": [
    {
      "node": "node:human:alice",
      "kind": "PRINCIPAL_TAKEOVER",
      "targets": [
        {
          "node": "node:credential:index-admin-cred",
          "class": "PRIVILEGED_CREDENTIAL",
          "exposure": "CONTAINED",
          "route": [
            "node:human:alice",
            "node:credential:index-admin-cred"
          ],
          "control_state": "CONTROLS_HELD",
          "frontier_properties": [
            "AGENT.IDENTITY.PRIVILEGE_AMPLIFICATION"
          ]
        },
        {
          "node": "node:credential:mcp-auth:${run:0}:cred-upstream",
          "class": "PRIVILEGED_CREDENTIAL",
          "exposure": "CONTAINED",
          "route": [
            "node:human:alice",
            "node:credential:inbound-token",
            "node:mcp-server:mcp-auth:${run:0}:mcp-invoices",
            "node:credential:mcp-auth:${run:0}:cred-upstream"
          ],
          "control_state": "CONTROL_UNDECIDED",
          "frontier_properties": [
            "MCP.AUTH.CREDENTIAL_SEPARATION",
            "MCP.IDENTITY.SELF_REPORTED_METADATA_BOUNDARY"
          ]
        },
        {
          "node": "node:resource:mcp-auth:${run:1}:mcp-invoices",
          "class": "SENSITIVE_RESOURCE",
          "exposure": "CONTAINED",
          "route": [
            "node:human:alice",
            "node:resource:mcp-auth:${run:1}:mcp-invoices"
          ],
          "control_state": "CONTROLS_HELD",
          "frontier_properties": [
            "MCP.AUTH.FINAL_OPERATION_BINDING"
          ]
        },
        {
          "node": "node:resource:mcp-auth:${run:0}:mcp-invoices",
          "class": "SENSITIVE_RESOURCE",
          "exposure": "EXPOSED",
          "route": [
            "node:human:alice",
            "node:resource:mcp-auth:${run:0}:mcp-invoices"
          ],
          "control_state": "CONTROL_UNDECIDED"
        }
      ]
    }
  ]
}
